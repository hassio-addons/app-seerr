#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: Seerr
# Runs Seerr
# ==============================================================================
export NODE_ENV=production
export PORT=5055
export CONFIG_DIRECTORY="/config"

bashio::log.info 'Starting Seerr...'

# Marks the configuration directory as being provided by the container,
# which stops Seerr from warning about a missing data volume.
touch "${CONFIG_DIRECTORY}/DOCKER"

# HOST is deliberately left unset. Seerr binds to a single address when it is
# set, so setting it to 0.0.0.0 leaves the server on IPv4 only, and the
# requests Seerr makes to itself fail whenever localhost resolves to ::1.
# Unset, Node listens on both stacks, and falls back to IPv4 on its own when
# IPv6 is unavailable.
cd /opt || bashio::exit.nok 'Could not change directory to /opt'
exec node dist/index.js
